[
 {
  "text": "Погана оцінка з математики,",
  "from": 0,
  "dur": 37
 },
 {
  "text": "нас ведуть до репетитора.",
  "from": 37,
  "dur": 41
 },
 {
  "text": "Погана оцінка з хімії,",
  "from": 80,
  "dur": 33
 },
 {
  "text": "мама з татом обкладаються підручниками",
  "from": 115,
  "dur": 52
 },
 {
  "text": "і намагаються тобі пояснити",
  "from": 167,
  "dur": 31
 },
 {
  "text": "ці валентності і зв'язки між",
  "from": 198,
  "dur": 40
 },
 {
  "text": "хімічними елементами і зубрити",
  "from": 238,
  "dur": 43
 },
 {
  "text": "з тобою таблицю Менделєєва.",
  "from": 281,
  "dur": 52
 },
 {
  "text": "Ми всі жертви того феномену,",
  "from": 339,
  "dur": 55
 },
 {
  "text": "що підтягнути завжди треба",
  "from": 394,
  "dur": 57
 },
 {
  "text": "те, що в тебе не виходить,",
  "from": 451,
  "dur": 42
 },
 {
  "text": "ніби закрити свої слабкі сторони.",
  "from": 498,
  "dur": 49
 },
 {
  "text": "Але ж в світі існує інша практика,",
  "from": 548,
  "dur": 71
 },
 {
  "text": "яка дуже топова для європейських",
  "from": 620,
  "dur": 33
 },
 {
  "text": "країн і для Штатів,",
  "from": 653,
  "dur": 25
 },
 {
  "text": "коли люди не підтягують слабкі",
  "from": 679,
  "dur": 86
 },
 {
  "text": "сторони, вони навпаки підсилюють",
  "from": 765,
  "dur": 47
 },
 {
  "text": "свої сильні сторони.",
  "from": 812,
  "dur": 36
 },
 {
  "text": "І, напевно, ви чули про тест",
  "from": 850,
  "dur": 76
 },
 {
  "text": "Гелапа. Він дуже популярний",
  "from": 926,
  "dur": 38
 },
 {
  "text": "зараз на території України,",
  "from": 964,
  "dur": 55
 },
 {
  "text": "а в Штатах це взагалі один",
  "from": 1019,
  "dur": 35
 },
 {
  "text": "з маст-хев, коли ти подаєш",
  "from": 1054,
  "dur": 38
 },
 {
  "text": "резюме в якусь велику компанію,",
  "from": 1092,
  "dur": 36
 },
 {
  "text": "корпорацію.",
  "from": 1129,
  "dur": 14
 },
 {
  "text": "Це best practice.",
  "from": 1155,
  "dur": 37
 },
 {
  "text": "В тебе в резюме мають бути",
  "from": 1195,
  "dur": 51
 },
 {
  "text": "вказані твої сильні сторони",
  "from": 1246,
  "dur": 66
 },
 {
  "text": "згідно з класифікацією і результатами",
  "from": 1312,
  "dur": 79
 },
 {
  "text": "тесту Гелапа.",
  "from": 1391,
  "dur": 19
 },
 {
  "text": "Для того, щоб рекрутери розуміли,",
  "from": 1412,
  "dur": 56
 },
 {
  "text": "куди і як тебе краще розподілити",
  "from": 1470,
  "dur": 46
 },
 {
  "text": "і як краще використовувати",
  "from": 1516,
  "dur": 27
 },
 {
  "text": "твої сильні сторони.",
  "from": 1543,
  "dur": 24
 },
 {
  "text": "От ми розуміємо,",
  "from": 1568,
  "dur": 21
 },
 {
  "text": "що ми там, не знаю,",
  "from": 1589,
  "dur": 24
 },
 {
  "text": "learner, або strategic,",
  "from": 1616,
  "dur": 29
 },
 {
  "text": "strategic, або empathy,",
  "from": 1645,
  "dur": 31
 },
 {
  "text": "так, це наші сильні сторони.",
  "from": 1682,
  "dur": 39
 },
 {
  "text": "І часто так складається,",
  "from": 1722,
  "dur": 50
 },
 {
  "text": "що ті позиції,",
  "from": 1774,
  "dur": 22
 },
 {
  "text": "ті роботи, на яких ми працюємо,",
  "from": 1796,
  "dur": 48
 },
 {
  "text": "або те, що ми робимо в житті",
  "from": 1844,
  "dur": 30
 },
 {
  "text": "за гроші, взагалі ніяк не відповідає",
  "from": 1874,
  "dur": 57
 },
 {
  "text": "до наших основних сильних сторін.",
  "from": 1931,
  "dur": 74
 },
 {
  "text": "І що ж тут робити?",
  "from": 2017,
  "dur": 27
 },
 {
  "text": "По суті, в нас є три варіанти.",
  "from": 2047,
  "dur": 27
 },
 {
  "text": "Перший варіант —",
  "from": 2076,
  "dur": 19
 },
 {
  "text": "це йти у своє і розуміти,",
  "from": 2095,
  "dur": 36
 },
 {
  "text": "що, так, окей, я там strategic,",
  "from": 2133,
  "dur": 38
 },
 {
  "text": "значить, я зараз розвиваю свій",
  "from": 2177,
  "dur": 43
 },
 {
  "text": "особистий бренд стратегічного",
  "from": 2220,
  "dur": 49
 },
 {
  "text": "планувальника або стратегічного",
  "from": 2269,
  "dur": 66
 },
 {
  "text": "консультанта для великих бізнесів.",
  "from": 2335,
  "dur": 44
 },
 {
  "text": "Другий варіант —",
  "from": 2379,
  "dur": 29
 },
 {
  "text": "це міняти сферу діяльності.",
  "from": 2408,
  "dur": 41
 },
 {
  "text": "Наприклад, я, не знаю,",
  "from": 2449,
  "dur": 48
 },
 {
  "text": "чудова емпатка,",
  "from": 2498,
  "dur": 36
 },
 {
  "text": "значить, я зараз йду і вчуся",
  "from": 2534,
  "dur": 63
 },
 {
  "text": "на психолога. Ну і третій варіант,",
  "from": 2597,
  "dur": 56
 },
 {
  "text": "з чим, на жаль,",
  "from": 2654,
  "dur": 24
 },
 {
  "text": "як я бачу, бо до мене приходять",
  "from": 2679,
  "dur": 49
 },
 {
  "text": "дівчата на консультації,",
  "from": 2728,
  "dur": 25
 },
 {
  "text": "які проходили подібний тест,",
  "from": 2753,
  "dur": 46
 },
 {
  "text": "вони отримали ці знання і далі",
  "from": 2813,
  "dur": 50
 },
 {
  "text": "вони їх ні в що не конвертували.",
  "from": 2863,
  "dur": 38
 },
 {
  "text": "Тобто вони просто отримали",
  "from": 2903,
  "dur": 53
 },
 {
  "text": "цю інсайтову інформацію,",
  "from": 2956,
  "dur": 46
 },
 {
  "text": "вони з нею живуть.",
  "from": 3004,
  "dur": 22
 },
 {
  "text": "Тобто ніяк вони ці зміни не",
  "from": 3028,
  "dur": 43
 },
 {
  "text": "імплементували в життя.",
  "from": 3071,
  "dur": 28
 },
 {
  "text": "І так також можна.",
  "from": 3101,
  "dur": 31
 },
 {
  "text": "Але саме це і нарощує певну",
  "from": 3132,
  "dur": 68
 },
 {
  "text": "фрустрацію. Я би в цій ситуації",
  "from": 3200,
  "dur": 43
 },
 {
  "text": "пропонувала четвертий варіант.",
  "from": 3243,
  "dur": 38
 },
 {
  "text": "Суть в тому, що ми отримуємо",
  "from": 3284,
  "dur": 65
 },
 {
  "text": "задоволення не лише від грошей.",
  "from": 3349,
  "dur": 46
 },
 {
  "text": "І згідно цього тесту,",
  "from": 3397,
  "dur": 56
 },
 {
  "text": "якщо ми рухаємося,",
  "from": 3454,
  "dur": 53
 },
 {
  "text": "розвиваючи або в сторону своїх",
  "from": 3508,
  "dur": 72
 },
 {
  "text": "сильних сторін якимось чином,",
  "from": 3580,
  "dur": 50
 },
 {
  "text": "ми отримуємо або фінансове",
  "from": 3632,
  "dur": 75
 },
 {
  "text": "задоволення, або і моральне",
  "from": 3707,
  "dur": 65
 },
 {
  "text": "задоволення, або і то,",
  "from": 3772,
  "dur": 30
 },
 {
  "text": "і то. І якщо так складається",
  "from": 3802,
  "dur": 48
 },
 {
  "text": "життя наразі у вас,",
  "from": 3850,
  "dur": 62
 },
 {
  "text": "що ви не можете повернути свою",
  "from": 3912,
  "dur": 47
 },
 {
  "text": "кар'єру, своє життя в те русло,",
  "from": 3959,
  "dur": 44
 },
 {
  "text": "щоб реалізувати свої сильні",
  "from": 4003,
  "dur": 51
 },
 {
  "text": "сторони за гроші,",
  "from": 4054,
  "dur": 33
 },
 {
  "text": "то пробуйте реалізувати їх",
  "from": 4089,
  "dur": 53
 },
 {
  "text": "безкоштовно.",
  "from": 4142,
  "dur": 24
 },
 {
  "text": "І ви все одно від цього не",
  "from": 4167,
  "dur": 30
 },
 {
  "text": "програєте. Про що я?",
  "from": 4197,
  "dur": 39
 },
 {
  "text": "Про те, що якщо вам дуже подобається",
  "from": 4237,
  "dur": 78
 },
 {
  "text": "викладати, або ви емпат,",
  "from": 4315,
  "dur": 34
 },
 {
  "text": "на роботі ініціюйте,",
  "from": 4354,
  "dur": 40
 },
 {
  "text": "що ви стаєте головою,",
  "from": 4395,
  "dur": 57
 },
 {
  "text": "не знаю, там, learning development",
  "from": 4452,
  "dur": 39
 },
 {
  "text": "відділу, що ви вчите новачків,",
  "from": 4491,
  "dur": 81
 },
 {
  "text": "що ви передаєте знання,",
  "from": 4573,
  "dur": 30
 },
 {
  "text": "що ви організовуєте для них",
  "from": 4606,
  "dur": 31
 },
 {
  "text": "якесь навчання.",
  "from": 4637,
  "dur": 20
 },
 {
  "text": "В такий спосіб реалізувати",
  "from": 4660,
  "dur": 52
 },
 {
  "text": "свою потребу, відповідати своїм",
  "from": 4712,
  "dur": 47
 },
 {
  "text": "сильним сторонам.",
  "from": 4759,
  "dur": 24
 },
 {
  "text": "І повірте мені,",
  "from": 4794,
  "dur": 28
 },
 {
  "text": "коли ви закриєте цю свою потребу",
  "from": 4825,
  "dur": 66
 },
 {
  "text": "навіть без грошей,",
  "from": 4891,
  "dur": 36
 },
 {
  "text": "у вас вивільниться купа енергії",
  "from": 4928,
  "dur": 59
 },
 {
  "text": "на те, щоб заробляти більше,",
  "from": 4987,
  "dur": 69
 },
 {
  "text": "на те, щоб робити більше проєктів,",
  "from": 5056,
  "dur": 53
 },
 {
  "text": "брати більше підробіток,",
  "from": 5109,
  "dur": 37
 },
 {
  "text": "виконувати свої функції і незвичайні",
  "from": 5146,
  "dur": 47
 },
 {
  "text": "роботи. Таким чином нематеріальна",
  "from": 5193,
  "dur": 62
 },
 {
  "text": "реалізація ваших талантів дасть",
  "from": 5255,
  "dur": 75
 },
 {
  "text": "вам можливість заробити більше.",
  "from": 5330,
  "dur": 58
 }
]