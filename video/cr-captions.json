[
 {
  "text": "Останнім часом я частіше зустрічаю",
  "from": 0,
  "dur": 91,
  "s": 0.0,
  "e": 3.04
 },
 {
  "text": "на різних джобсайтах вакансії",
  "from": 91,
  "dur": 48,
  "s": 3.04,
  "e": 4.62
 },
 {
  "text": "рівня CEO або COO,",
  "from": 139,
  "dur": 51,
  "s": 4.62,
  "e": 6.32
 },
 {
  "text": "тобто або CEO компанії,",
  "from": 191,
  "dur": 41,
  "s": 6.36,
  "e": 7.74
 },
 {
  "text": "або операційний директор компанії.",
  "from": 233,
  "dur": 65,
  "s": 7.78,
  "e": 9.92
 },
 {
  "text": "І про що це говорить?",
  "from": 300,
  "dur": 34,
  "s": 10.0,
  "e": 11.12
 },
 {
  "text": "Ну, в першу чергу,",
  "from": 338,
  "dur": 18,
  "s": 11.26,
  "e": 11.86
 },
 {
  "text": "це про певну операційну втому,",
  "from": 356,
  "dur": 60,
  "s": 11.86,
  "e": 13.88
 },
 {
  "text": "коли власники бізнесів вже",
  "from": 419,
  "dur": 41,
  "s": 13.98,
  "e": 15.34
 },
 {
  "text": "більше не можуть в поточних",
  "from": 460,
  "dur": 43,
  "s": 15.34,
  "e": 16.78
 },
 {
  "text": "складних економічних і політичних",
  "from": 503,
  "dur": 55,
  "s": 16.78,
  "e": 18.6
 },
 {
  "text": "обставинах вести бізнес day-to-day",
  "from": 558,
  "dur": 65,
  "s": 18.6,
  "e": 20.76
 },
 {
  "text": "І вони шукають людину,",
  "from": 623,
  "dur": 35,
  "s": 20.76,
  "e": 21.92
 },
 {
  "text": "на яку можна це перекласти.",
  "from": 658,
  "dur": 41,
  "s": 21.94,
  "e": 23.3
 },
 {
  "text": "Але ще цікаво,",
  "from": 705,
  "dur": 29,
  "s": 23.5,
  "e": 24.48
 },
 {
  "text": "я помітила, що більшість цих",
  "from": 734,
  "dur": 71,
  "s": 24.48,
  "e": 26.84
 },
 {
  "text": "вакансій, які є опублікованими",
  "from": 805,
  "dur": 54,
  "s": 26.84,
  "e": 28.64
 },
 {
  "text": "у відкритому доступі,",
  "from": 859,
  "dur": 41,
  "s": 28.64,
  "e": 30.0
 },
 {
  "text": "є трошечки номінальними,",
  "from": 900,
  "dur": 33,
  "s": 30.0,
  "e": 31.1
 },
 {
  "text": "тому що вони мають в собі дуже",
  "from": 933,
  "dur": 51,
  "s": 31.1,
  "e": 32.8
 },
 {
  "text": "багато різноманітних функцій.",
  "from": 984,
  "dur": 44,
  "s": 32.8,
  "e": 34.28
 },
 {
  "text": "Таке відчуття,",
  "from": 1030,
  "dur": 13,
  "s": 34.34,
  "e": 34.78
 },
 {
  "text": "що просто власник з голови",
  "from": 1045,
  "dur": 39,
  "s": 34.82,
  "e": 36.12
 },
 {
  "text": "вигрузив туди абсолютно все,",
  "from": 1084,
  "dur": 40,
  "s": 36.12,
  "e": 37.48
 },
 {
  "text": "що в нього було.",
  "from": 1128,
  "dur": 19,
  "s": 37.6,
  "e": 38.24
 },
 {
  "text": "І от він шукає людину,",
  "from": 1153,
  "dur": 25,
  "s": 38.42,
  "e": 39.28
 },
 {
  "text": "яка закриє всі ці питання на",
  "from": 1179,
  "dur": 52,
  "s": 39.3,
  "e": 41.02
 },
 {
  "text": "зарплату від 50 до 70 тисяч",
  "from": 1231,
  "dur": 66,
  "s": 41.02,
  "e": 43.24
 },
 {
  "text": "гривень. Та навіть до мене",
  "from": 1297,
  "dur": 33,
  "s": 43.24,
  "e": 44.34
 },
 {
  "text": "місяця 3 чи 4 назад стукалася",
  "from": 1330,
  "dur": 53,
  "s": 44.34,
  "e": 46.1
 },
 {
  "text": "доволі велика освітня мережа,",
  "from": 1383,
  "dur": 46,
  "s": 46.1,
  "e": 47.64
 },
 {
  "text": "яка представлена не лише в",
  "from": 1430,
  "dur": 67,
  "s": 47.68,
  "e": 49.9
 },
 {
  "text": "Україні. І вони запрошували",
  "from": 1497,
  "dur": 44,
  "s": 49.9,
  "e": 51.38
 },
 {
  "text": "мене стати їх CEO із зарплатою",
  "from": 1541,
  "dur": 68,
  "s": 51.38,
  "e": 53.62
 },
 {
  "text": "50 тисяч гривень в місяць,",
  "from": 1609,
  "dur": 39,
  "s": 53.62,
  "e": 54.94
 },
 {
  "text": "flat price, без бонусів.",
  "from": 1648,
  "dur": 49,
  "s": 54.94,
  "e": 56.56
 },
 {
  "text": "По суті, вони шукали менеджера,",
  "from": 1700,
  "dur": 110,
  "s": 56.68,
  "e": 60.32
 },
 {
  "text": "додавши в requirements,",
  "from": 1812,
  "dur": 65,
  "s": 60.4,
  "e": 62.56
 },
 {
  "text": "у вимоги, просто якомога більше",
  "from": 1885,
  "dur": 75,
  "s": 62.84,
  "e": 65.32
 },
 {
  "text": "всього, що було почуто,",
  "from": 1960,
  "dur": 34,
  "s": 65.32,
  "e": 66.46
 },
 {
  "text": "що було зліплено з ChatGPT",
  "from": 1996,
  "dur": 87,
  "s": 66.52,
  "e": 69.44
 },
 {
  "text": "по best practices,",
  "from": 2083,
  "dur": 35,
  "s": 69.44,
  "e": 70.6
 },
 {
  "text": "що має робити CEO і COO одночасно.",
  "from": 2119,
  "dur": 98,
  "s": 70.64,
  "e": 73.9
 },
 {
  "text": "Тож я до того,",
  "from": 2236,
  "dur": 26,
  "s": 74.54,
  "e": 75.4
 },
 {
  "text": "що от такі псевдономінальні",
  "from": 2264,
  "dur": 53,
  "s": 75.46,
  "e": 77.24
 },
 {
  "text": "CEO і COO вакансії є багато",
  "from": 2317,
  "dur": 85,
  "s": 77.24,
  "e": 80.06
 },
 {
  "text": "де. Вони є доволі обмеженими.",
  "from": 2402,
  "dur": 49,
  "s": 80.06,
  "e": 81.7
 },
 {
  "text": "По суті, це людина-менеджер",
  "from": 2452,
  "dur": 41,
  "s": 81.74,
  "e": 83.1
 },
 {
  "text": "над менеджерами,",
  "from": 2493,
  "dur": 19,
  "s": 83.1,
  "e": 83.72
 },
 {
  "text": "це максимум. Але є і закриті",
  "from": 2513,
  "dur": 74,
  "s": 83.76,
  "e": 86.22
 },
 {
  "text": "канали пошуку вакансій,",
  "from": 2587,
  "dur": 39,
  "s": 86.22,
  "e": 87.52
 },
 {
  "text": "там CEO чомусь мають зарплату",
  "from": 2626,
  "dur": 48,
  "s": 87.52,
  "e": 89.12
 },
 {
  "text": "від 12 до 15 тисяч доларів.",
  "from": 2674,
  "dur": 52,
  "s": 89.12,
  "e": 90.88
 },
 {
  "text": "І таких людей дуже складно",
  "from": 2729,
  "dur": 65,
  "s": 90.96,
  "e": 93.14
 },
 {
  "text": "знайти, їх ринок є вкрай маленьким,",
  "from": 2794,
  "dur": 63,
  "s": 93.14,
  "e": 95.22
 },
 {
  "text": "це дуже маленький відсоток",
  "from": 2857,
  "dur": 37,
  "s": 95.22,
  "e": 96.46
 },
 {
  "text": "професіоналів на ринку.",
  "from": 2894,
  "dur": 51,
  "s": 96.46,
  "e": 98.16
 },
 {
  "text": "І більшість з них вже працюють",
  "from": 2946,
  "dur": 40,
  "s": 98.2,
  "e": 99.52
 },
 {
  "text": "у великих компаніях і не дуже",
  "from": 2986,
  "dur": 45,
  "s": 99.52,
  "e": 101.04
 },
 {
  "text": "активно розглядають зміну роботи.",
  "from": 3031,
  "dur": 88,
  "s": 101.04,
  "e": 103.96
 },
 {
  "text": "Тож, по суті, існує три варіанти.",
  "from": 3121,
  "dur": 58,
  "s": 104.02,
  "e": 105.96
 },
 {
  "text": "Або ви хантите іншого CEO з",
  "from": 3181,
  "dur": 60,
  "s": 106.04,
  "e": 108.04
 },
 {
  "text": "іншої компанії,",
  "from": 3241,
  "dur": 21,
  "s": 108.04,
  "e": 108.72
 },
 {
  "text": "це людина за великі гроші,",
  "from": 3262,
  "dur": 40,
  "s": 108.74,
  "e": 110.06
 },
 {
  "text": "яка повноцінно бере відповідальність",
  "from": 3302,
  "dur": 50,
  "s": 110.06,
  "e": 111.74
 },
 {
  "text": "за ваш бізнес і веде його,",
  "from": 3352,
  "dur": 38,
  "s": 111.74,
  "e": 113.0
 },
 {
  "text": "стратегує, звіряється з метриками,",
  "from": 3392,
  "dur": 50,
  "s": 113.08,
  "e": 114.74
 },
 {
  "text": "відповідає за злети і падіння,",
  "from": 3465,
  "dur": 43,
  "s": 115.5,
  "e": 116.94
 },
 {
  "text": "ну, одним словом, за все.",
  "from": 3509,
  "dur": 27,
  "s": 116.98,
  "e": 117.88
 },
 {
  "text": "Або ви берете людину на виріст.",
  "from": 3550,
  "dur": 79,
  "s": 118.34,
  "e": 120.96
 },
 {
  "text": "Про що це? Це людина,",
  "from": 3632,
  "dur": 32,
  "s": 121.06,
  "e": 122.12
 },
 {
  "text": "яка, наприклад,",
  "from": 3664,
  "dur": 21,
  "s": 122.12,
  "e": 122.84
 },
 {
  "text": "була CEO в меншій компанії",
  "from": 3685,
  "dur": 40,
  "s": 122.84,
  "e": 124.18
 },
 {
  "text": "або ніколи не була CEO або",
  "from": 3725,
  "dur": 38,
  "s": 124.18,
  "e": 125.44
 },
 {
  "text": "операційним директором,",
  "from": 3763,
  "dur": 28,
  "s": 125.44,
  "e": 126.36
 },
 {
  "text": "була якимось там бренд-менеджером,",
  "from": 3791,
  "dur": 60,
  "s": 126.38,
  "e": 128.36
 },
 {
  "text": "головою відділу якогось менеджменту,",
  "from": 3851,
  "dur": 56,
  "s": 128.36,
  "e": 130.22
 },
 {
  "text": "і ви свідомо розумієте,",
  "from": 3907,
  "dur": 33,
  "s": 130.24,
  "e": 131.32
 },
 {
  "text": "що, наприклад,",
  "from": 3940,
  "dur": 16,
  "s": 131.32,
  "e": 131.88
 },
 {
  "text": "найближче півроку ви вкладаєте",
  "from": 3958,
  "dur": 72,
  "s": 131.92,
  "e": 134.34
 },
 {
  "text": "в цю людину, відправляєте її",
  "from": 4030,
  "dur": 57,
  "s": 134.34,
  "e": 136.24
 },
 {
  "text": "на навчання, можливо,",
  "from": 4087,
  "dur": 28,
  "s": 136.24,
  "e": 137.18
 },
 {
  "text": "навіть і рік, якийсь MBA і",
  "from": 4115,
  "dur": 47,
  "s": 137.18,
  "e": 138.72
 },
 {
  "text": "так далі, що цей ваш відхил,",
  "from": 4162,
  "dur": 50,
  "s": 138.72,
  "e": 140.4
 },
 {
  "text": "ви умовно шукаєте по софт-скілах,",
  "from": 4212,
  "dur": 57,
  "s": 140.4,
  "e": 142.3
 },
 {
  "text": "з мінімальним набором",
  "from": 4272,
  "dur": 52,
  "s": 142.4,
  "e": 144.12
 },
 {
  "text": "хард-скілів для менеджменту,",
  "from": 4324,
  "dur": 38,
  "s": 144.12,
  "e": 145.4
 },
 {
  "text": "і потім ви вкладаєте в цю людину,",
  "from": 4363,
  "dur": 48,
  "s": 145.42,
  "e": 147.04
 },
 {
  "text": "щоби вона через рік повноцінно",
  "from": 4414,
  "dur": 60,
  "s": 147.12,
  "e": 149.14
 },
 {
  "text": "змогла вас замінити.",
  "from": 4474,
  "dur": 26,
  "s": 149.14,
  "e": 150.0
 },
 {
  "text": "Але все одно це доволі тривалий",
  "from": 4502,
  "dur": 58,
  "s": 150.08,
  "e": 152.0
 },
 {
  "text": "і ресурсно затратний процес.",
  "from": 4560,
  "dur": 54,
  "s": 152.0,
  "e": 153.8
 },
 {
  "text": "І третій варіант —",
  "from": 4618,
  "dur": 25,
  "s": 153.94,
  "e": 154.78
 },
 {
  "text": "це виростити людину із середини",
  "from": 4643,
  "dur": 54,
  "s": 154.78,
  "e": 156.58
 },
 {
  "text": "компанії. І тут,",
  "from": 4697,
  "dur": 27,
  "s": 156.58,
  "e": 157.46
 },
 {
  "text": "що нам говорить статистика,",
  "from": 4724,
  "dur": 39,
  "s": 157.48,
  "e": 158.76
 },
 {
  "text": "яка дуже вперта наука.",
  "from": 4763,
  "dur": 52,
  "s": 158.78,
  "e": 160.5
 },
 {
  "text": "50% керівників CEO компаній,",
  "from": 4840,
  "dur": 75,
  "s": 161.32,
  "e": 163.82
 },
 {
  "text": "які входять у S&P 500,",
  "from": 4915,
  "dur": 51,
  "s": 163.82,
  "e": 165.52
 },
 {
  "text": "а це найбільші,",
  "from": 4971,
  "dur": 28,
  "s": 165.7,
  "e": 166.64
 },
 {
  "text": "найприбутковіші компанії світу,",
  "from": 5000,
  "dur": 48,
  "s": 166.66,
  "e": 168.26
 },
 {
  "text": "вони були вирощені в компанії,",
  "from": 5050,
  "dur": 73,
  "s": 168.32,
  "e": 170.76
 },
 {
  "text": "і це їх внутрішній найм.",
  "from": 5123,
  "dur": 43,
  "s": 170.76,
  "e": 172.2
 },
 {
  "text": "Тобто, роками інвестували в",
  "from": 5174,
  "dur": 56,
  "s": 172.48,
  "e": 174.34
 },
 {
  "text": "людей для того,",
  "from": 5230,
  "dur": 22,
  "s": 174.34,
  "e": 175.08
 },
 {
  "text": "щоби вони стали продуктом цієї",
  "from": 5255,
  "dur": 65,
  "s": 175.18,
  "e": 177.32
 },
 {
  "text": "компанії, і потім повноцінно,",
  "from": 5320,
  "dur": 48,
  "s": 177.32,
  "e": 178.92
 },
 {
  "text": "розуміючи потреби,",
  "from": 5369,
  "dur": 30,
  "s": 178.96,
  "e": 179.98
 },
 {
  "text": "вимоги і специфіку компанії,",
  "from": 5400,
  "dur": 52,
  "s": 180.0,
  "e": 181.72
 },
 {
  "text": "змогли нею керувати.",
  "from": 5453,
  "dur": 36,
  "s": 181.76,
  "e": 182.96
 },
 {
  "text": "Тобто, роками вони вчили,",
  "from": 5497,
  "dur": 33,
  "s": 183.24,
  "e": 184.34
 },
 {
  "text": "дорощували людей для того,",
  "from": 5531,
  "dur": 39,
  "s": 184.38,
  "e": 185.66
 },
 {
  "text": "щоби вони стали CEO цієї компанії.",
  "from": 5572,
  "dur": 61,
  "s": 185.72,
  "e": 187.76
 },
 {
  "text": "Вони продовжують бути цією",
  "from": 5634,
  "dur": 32,
  "s": 187.8,
  "e": 188.86
 },
 {
  "text": "компанією дуже успішними.",
  "from": 5666,
  "dur": 33,
  "s": 188.86,
  "e": 189.96
 },
 {
  "text": "Ну, так виглядає,",
  "from": 5701,
  "dur": 31,
  "s": 190.04,
  "e": 191.08
 },
 {
  "text": "що це так. Це оптимальний варіант.",
  "from": 5733,
  "dur": 27,
  "s": 191.1,
  "e": 192.0
 },
 {
  "text": "Тож, якщо ви просто маєте операційну",
  "from": 5762,
  "dur": 54,
  "s": 192.06,
  "e": 193.88
 },
 {
  "text": "втому, візьміть собі асистента",
  "from": 5816,
  "dur": 51,
  "s": 193.88,
  "e": 195.58
 },
 {
  "text": "чи двох, з яких ви почнете потрохи",
  "from": 5867,
  "dur": 91,
  "s": 195.58,
  "e": 198.6
 },
 {
  "text": "вирощувати собі заміну.",
  "from": 5958,
  "dur": 49,
  "s": 198.6,
  "e": 200.22
 },
 {
  "text": "Якщо ваш бізнес не є суперглобальним,",
  "from": 6013,
  "dur": 61,
  "s": 200.42,
  "e": 202.46
 },
 {
  "text": "ви не можете собі дозволити",
  "from": 6074,
  "dur": 29,
  "s": 202.46,
  "e": 203.44
 },
 {
